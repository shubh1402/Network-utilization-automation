# ---------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored: never commit it.
# ---------------------------------------------------------------

# demo | zabbix | txt
DATA_SOURCE=demo

# Timezone used for report days and all displayed times
REPORT_TIMEZONE=Asia/Kolkata

# Site inventory. Put your real sites in config/sites.local.json (git-ignored)
# SITES_FILE=config/sites.local.json

# --- Zabbix API (DATA_SOURCE=zabbix) ---------------------------
ZABBIX_API_URL=https://zabbix.example.com/api_jsonrpc.php
ZABBIX_API_TOKEN=
ZABBIX_VERIFY_SSL=true
# header = Authorization: Bearer (Zabbix 6.4+), body = legacy "auth" field
ZABBIX_AUTH_MODE=header

# Item names on each site host (defaults shown)
# ZABBIX_ITEM_PRIMARY_IN=Primary link utilization inbound
# ZABBIX_ITEM_PRIMARY_OUT=Primary link utilization outbound
# ZABBIX_ITEM_SECONDARY_IN=Secondary link utilization inbound
# ZABBIX_ITEM_SECONDARY_OUT=Secondary link utilization outbound

# --- Graphs ------------------------------------------------------
# render = draw from collected data (default), zabbix = Selenium screenshots
GRAPH_MODE=render
ZABBIX_WEB_URL=https://zabbix.example.com
ZABBIX_WEB_USERNAME=
ZABBIX_WEB_PASSWORD=
HEADLESS=true

# --- FortiGate top-talker captures (one block per site) ----------
# KEY is the site's "fortigate_key" in sites.json
FORTIGATE_PUNE_URL=
FORTIGATE_PUNE_USERNAME=
FORTIGATE_PUNE_PASSWORD=
# FORTIGATE_VIEW_PATH=/ng/fortiview/sources
# FORTIGATE_TABLE_ROW_SELECTOR=table tbody tr
# FORTIGATE_LOGIN_USER_FIELD=username
# FORTIGATE_LOGIN_PASSWORD_FIELD=secretkey
# FORTIGATE_LOGIN_BUTTON=login_button

# --- Checks --------------------------------------------------------
# Flag a link when fewer than this share of per-minute samples arrived
MIN_COVERAGE=0.98
